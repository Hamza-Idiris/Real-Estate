# --- Required ---
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/estateflow
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
FILE_SIGNING_SECRET=change-me-too-change-me-too-change-me-too

# --- Optional ---
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set true ONLY when MongoDB runs as a replica set (required for multi-document transactions)
USE_TRANSACTIONS=false
UPLOAD_DIR=uploads
PUBLIC_API_URL=http://localhost:4000
VIEWING_SLOT_MINUTES=30
TRUST_PROXY=false
LOG_LEVEL=info
RUN_JOBS=true
